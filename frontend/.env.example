# FOR THE FRONTEND TO REACH THE BACKEND, CREATE A .env FILE WITH THE FOLLOWING STRUCTURE
# THIS FILE MUST BE LOCATED AT THE ROOT OF THE FRONTEND DIRECTORY

# Base URL of the backend API (must include the /api prefix)
VITE_API_BASE_URL=http://localhost:8000/api

# Base URL used to fetch contract signature images (backend root, no /api prefix)
VITE_API_BASE_URL_IMAGES=http://localhost:8000
